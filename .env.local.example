# BuildTripForYou — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.
#
# Rule (PRD Section 44): API keys/secrets are kept server-side wherever possible.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.

# --- Supabase (Auth + Postgres) — wired in Phase 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform (Routes / Places / Geocoding) — wired in Phase 6 ---
# Server-side only.
GOOGLE_MAPS_API_KEY=

# Separate, HTTP-referrer-restricted key for the client-side embedded map
# on the Map screen (PRD Section 29). Safe to expose to the browser — that's
# what NEXT_PUBLIC_ means — but restrict it to your domain(s) in Google
# Cloud Console so it can't be reused elsewhere.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Weather provider (default: OpenWeatherMap) — wired in Phase 8 ---
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# --- AI provider (Anthropic Claude API) — wired in Phase 5 ---
ANTHROPIC_API_KEY=

# --- Trip hero-photo search (Pexels) ---
# Server-side only. Free key from https://www.pexels.com/api/ — without it,
# the "search a photo" picker shows placeholder demo photos instead of real
# search results.
PEXELS_API_KEY=

# --- Flight status (AviationStack) ---
# Server-side only. Free key from https://aviationstack.com/ — without it,
# "Check Flight Status" reports that live status isn't set up. There is
# deliberately no demo/mock fallback: a made-up gate or delay could send
# someone to the wrong place.
AVIATIONSTACK_API_KEY=

# --- Access code for /my-trip (src/middleware.ts) ---
# Server-side only. A 6-digit passcode required before /my-trip can be
# viewed at all — it holds real personal data with no account behind it.
# REQUIRED once you deploy: leaving this unset blocks /my-trip entirely
# (fails closed) rather than leaving it open.
MYTRIP_ACCESS_CODE=
